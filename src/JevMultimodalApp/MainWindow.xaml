<Window x:Class="JevMultimodalApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jev Multimodal - Qwen3-VL GGUF"
        Width="900" Height="920" MinWidth="680" MinHeight="700"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,4,6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Model selection -->
            <RowDefinition Height="Auto"/>
            <!-- Image + question -->
            <RowDefinition Height="Auto"/>
            <!-- Run row -->
            <RowDefinition Height="*"/>
            <!-- Response -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Model selection area -->
        <GroupBox Header="モデル選択" Grid.Row="0" Margin="0,0,0,10">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="本体GGUF:"/>
                <TextBox x:Name="ModelPathTextBox" Grid.Row="0" Grid.Column="1" Margin="0,3,8,3"/>
                <Button x:Name="BrowseModelButton" Grid.Row="0" Grid.Column="2" Content="参照..." Click="BrowseModelButton_Click" Margin="0,3,8,3"/>
                <Button x:Name="LoadModelButton" Grid.Row="0" Grid.Column="3" Content="モデル読み込み" Click="LoadModelButton_Click" Margin="0,3,0,3"/>

                <Label Grid.Row="1" Grid.Column="0" Content="mmproj:"/>
                <TextBox x:Name="MmprojPathTextBox" Grid.Row="1" Grid.Column="1" Margin="0,3,8,3"/>
                <Button x:Name="BrowseMmprojButton" Grid.Row="1" Grid.Column="2" Content="参照..." Click="BrowseMmprojButton_Click" Margin="0,3,8,3"/>

                <Label Grid.Row="2" Grid.Column="0" Content="バックエンド:"/>
                <Label x:Name="BackendLabel" Grid.Row="2" Grid.Column="1" Content="未読み込み" FontWeight="Bold"/>
            </Grid>
        </GroupBox>

        <!-- Image + question -->
        <GroupBox Header="画像・質問" Grid.Row="1" Margin="0,0,0,10">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="0,0,10,0">
                    <Border BorderBrush="#FFB0B0B0" BorderThickness="1" Width="150" Height="150" Background="#FFF2F2F2">
                        <Image x:Name="ImagePreview" Stretch="Uniform"/>
                    </Border>
                    <Button x:Name="BrowseImageButton" Content="画像を選択..." Click="BrowseImageButton_Click" Margin="0,6,0,0"/>
                </StackPanel>

                <Label Grid.Row="0" Grid.Column="1" Content="質問:"/>
                <TextBox x:Name="QuestionTextBox" Grid.Row="1" Grid.Column="1" Height="90"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Text="この画像には何が写っていますか。日本語で簡潔に説明してください。"/>
            </Grid>
        </GroupBox>

        <!-- Run row -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RunButton" Grid.Column="0" Content="推論実行" Click="RunButton_Click"
                    FontWeight="Bold" IsEnabled="False"/>
            <Label x:Name="LatencyLabel" Grid.Column="1" Content="Latency: -- ms" Margin="14,0,0,0"/>
        </Grid>

        <!-- Response -->
        <GroupBox Header="応答" Grid.Row="3" Margin="0,0,0,10">
            <TextBox x:Name="ResponseTextBox" Margin="6"
                     IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="White"/>
        </GroupBox>

        <!-- Status bar -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="モデル未読み込み"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
