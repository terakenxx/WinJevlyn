<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone experimental console app for trying multimodal (vision) models such as
    Qwen3-VL-8B-Instruct via LLamaSharp's Mtmd API. Deliberately kept separate from the main
    WinJevlyn app: the Mtmd pipeline (mmproj loading, media embedding, chunked decode) is a
    different code path from the plain-text single-pass logit extraction used by the main app,
    so mixing them would complicate the verified, working main app for no benefit here.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WinJevlyn.MultimodalPlayground</RootNamespace>
    <AssemblyName>WinJevlyn.MultimodalPlayground</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <!-- Both backends are referenced; NativeLibraryConfig picks CUDA at runtime when a
         compatible NVIDIA GPU/driver is present and falls back to CPU otherwise. -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.27.0" />
  </ItemGroup>

</Project>
