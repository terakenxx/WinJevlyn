<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WinJevlyn</RootNamespace>
    <AssemblyName>WinJevlyn</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- LLamaSharp: high-level GGUF loading/tokenization/decoding API -->
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <!-- CPU-only native backend (AVX/AVX2/AVX512 builds auto-selected at runtime) -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
  </ItemGroup>

</Project>
